# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Modern Supabase Configuration (sb_publishable_... & sb_secret_...)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-publishable-key"
SUPABASE_SECRET_KEY="sb_secret_your-secret-key"

# OpenRouter LLM API Configuration
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key"
EXTRACTION_MODEL="meta-llama/llama-3.3-70b-instruct"
EXTRACTION_MODEL_FALLBACK="anthropic/claude-3.5-sonnet"

# Admin Access (comma-separated email addresses)
ADMIN_EMAILS="admin@example.com"

# Inngest Background Jobs Configuration
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"
